import React, { useState, useEffect } from 'react';
import { 
  Menu, X, MapPin, Phone, Clock, ChevronRight, 
  Star, MessageCircle, Utensils, Heart, ShieldCheck, 
  Coffee, ArrowRight, Instagram, Facebook, Twitter
} from 'lucide-react';

// --- Placeholder Images (Using Unsplash) ---
const IMAGES = {
  hero: "https://images.unsplash.com/photo-1555396273-367ea4eb4db5?auto=format&fit=crop&q=80&w=1920",
  about: "https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?auto=format&fit=crop&q=80&w=800",
  banquet: "https://images.unsplash.com/photo-1519167758481-83f550bb49b3?auto=format&fit=crop&q=80&w=1200",
  food: {
    butterChicken: "https://images.unsplash.com/photo-1603894584373-5ac82b2ae398?auto=format&fit=crop&q=80&w=600",
    tofu: "https://images.unsplash.com/photo-1546069901-ba9599a7e63c?auto=format&fit=crop&q=80&w=600",
    fish: "https://images.unsplash.com/photo-1580476262798-bddd9f4b7369?auto=format&fit=crop&q=80&w=600",
    noodles: "https://images.unsplash.com/photo-1612927601601-6638404737ce?auto=format&fit=crop&q=80&w=600"
  },
  gallery: [
    "https://images.unsplash.com/photo-1544148103-0773bf10d330?auto=format&fit=crop&q=80&w=600",
    "https://images.unsplash.com/photo-1555939594-58d7cb561ad1?auto=format&fit=crop&q=80&w=600",
    "https://images.unsplash.com/photo-1533777857889-4be7c70b33f7?auto=format&fit=crop&q=80&w=600",
    "https://images.unsplash.com/photo-1540189549336-e6e99c3679fe?auto=format&fit=crop&q=80&w=600"
  ]
};

// --- Data ---
const MENU_CATEGORIES = ['All', 'Bengali', 'Indian', 'Chinese', 'Continental'];
const MENU_ITEMS = [
  { id: 1, name: "Butter Chicken", category: "Indian", price: "₹349", desc: "Our signature creamy, tomato-based gravy with charcoal-smoked tandoori chunks.", img: IMAGES.food.butterChicken, highlight: true },
  { id: 2, name: "Dhakai Fish Curry", category: "Bengali", price: "₹299", desc: "Fresh local catch simmered in authentic, aromatic spices.", img: IMAGES.food.fish },
  { id: 3, name: "Spicy Thai Basil Tofu", category: "Continental", price: "₹249", desc: "A fragrant, fiery delight with fresh basil and premium tofu.", img: IMAGES.food.tofu, highlight: true },
  { id: 4, name: "Hakka Noodles", category: "Chinese", price: "₹199", desc: "Street-style soul food tossed with fresh veggies and a gourmet twist.", img: IMAGES.food.noodles },
  { id: 5, name: "Kosha Mangsho", category: "Bengali", price: "₹449", desc: "Slow-cooked, rich and spicy mutton curry. A Sunday classic." },
  { id: 6, name: "Paneer Butter Masala", category: "Indian", price: "₹279", desc: "Soft paneer cubes in a rich, mildly sweet gravy." },
  { id: 7, name: "Chilli Garlic Chicken", category: "Chinese", price: "₹289", desc: "Crispy chicken tossed in a fiery garlic soy sauce." },
  { id: 8, name: "Grilled Bhetki Lemon Butter", category: "Continental", price: "₹499", desc: "Premium Kolkata Bhetki grilled to perfection with lemon butter sauce." },
];

const REVIEWS = [
  { id: 1, name: "Ananya S.", text: "Best family spot in Kalikapur! The hygiene standards are amazing, and the staff treated us like family. The Butter Chicken is a must-try!", rating: 5 },
  { id: 2, name: "Rahul M.", text: "Finally a place nearby where I can take my parents for authentic Bengali, and my kids for Chinese. Great ambiance and very pocket-friendly.", rating: 5 },
  { id: 3, name: "Priya D.", text: "The banquet hall is beautiful. We hosted our anniversary here and the catering was flawless. Highly recommend 1 Bite!", rating: 5 },
];

export default function App() {
  const [isScrolled, setIsScrolled] = useState(false);
  const [mobileMenuOpen, setMobileMenuOpen] = useState(false);
  const [activeCategory, setActiveCategory] = useState('All');

  // Handle Scroll for Navbar styling
  useEffect(() => {
    const handleScroll = () => {
      setIsScrolled(window.scrollY > 50);
    };
    window.addEventListener('scroll', handleScroll);
    return () => window.removeEventListener('scroll', handleScroll);
  }, []);

  const scrollToSection = (id) => {
    setMobileMenuOpen(false);
    const element = document.getElementById(id);
    if (element) {
      const offset = 80; // Navbar height
      const bodyRect = document.body.getBoundingClientRect().top;
      const elementRect = element.getBoundingClientRect().top;
      const elementPosition = elementRect - bodyRect;
      const offsetPosition = elementPosition - offset;

      window.scrollTo({
        top: offsetPosition,
        behavior: 'smooth'
      });
    }
  };

  const filteredMenu = activeCategory === 'All' 
    ? MENU_ITEMS 
    : MENU_ITEMS.filter(item => item.category === activeCategory);

  return (
    <div className="font-sans text-gray-800 bg-slate-50 relative">
      {/* --- Import Fonts --- */}
      <style>{`
        @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Inter:wght@300;400;500;600&display=swap');
        .font-serif { font-family: 'Playfair Display', serif; }
        .font-sans { font-family: 'Inter', sans-serif; }
        html { scroll-behavior: smooth; }
      `}</style>

      {/* --- Navigation --- */}
      <nav className={`fixed w-full z-50 transition-all duration-300 ${isScrolled ? 'bg-white shadow-md py-3' : 'bg-transparent py-5'}`}>
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div className="flex justify-between items-center">
            {/* Logo */}
            <div className="flex-shrink-0 cursor-pointer" onClick={() => window.scrollTo(0,0)}>
              <h1 className={`text-2xl font-serif font-bold ${isScrolled ? 'text-red-600' : 'text-white'}`}>
                1 Bite
                <span className="block text-xs font-sans font-normal tracking-widest text-gray-500 uppercase mt-0.5">Restaurant & Banquet</span>
              </h1>
            </div>

            {/* Desktop Menu */}
            <div className="hidden md:flex space-x-8 items-center">
              {['Home', 'About', 'Menu', 'Banquet', 'Gallery', 'Reviews'].map((item) => (
                <button 
                  key={item}
                  onClick={() => scrollToSection(item.toLowerCase())}
                  className={`text-sm font-medium hover:text-red-500 transition-colors ${isScrolled ? 'text-gray-700' : 'text-gray-100 drop-shadow-md'}`}
                >
                  {item}
                </button>
              ))}
              <button 
                onClick={() => scrollToSection('contact')}
                className="bg-red-600 text-white px-6 py-2.5 rounded-full font-medium hover:bg-red-700 transition-colors shadow-lg shadow-red-600/30"
              >
                Call Now
              </button>
            </div>

            {/* Mobile Menu Button */}
            <div className="md:hidden flex items-center">
              <button 
                onClick={() => setMobileMenuOpen(!mobileMenuOpen)}
                className={`${isScrolled ? 'text-gray-900' : 'text-white'}`}
              >
                {mobileMenuOpen ? <X size={28} /> : <Menu size={28} />}
              </button>
            </div>
          </div>
        </div>

        {/* Mobile Menu Dropdown */}
        {mobileMenuOpen && (
          <div className="md:hidden absolute top-full left-0 w-full bg-white shadow-xl py-4 flex flex-col items-center space-y-4 border-t border-gray-100">
            {['Home', 'About', 'Menu', 'Banquet', 'Gallery', 'Reviews', 'Contact'].map((item) => (
              <button 
                key={item}
                onClick={() => scrollToSection(item.toLowerCase())}
                className="text-gray-800 font-medium w-full py-2 hover:bg-red-50 hover:text-red-600 transition-colors"
              >
                {item}
              </button>
            ))}
          </div>
        )}
      </nav>

      {/* --- Hero Section --- */}
      <section id="home" className="relative h-screen flex items-center justify-center overflow-hidden">
        {/* Background Image with Overlay */}
        <div className="absolute inset-0 w-full h-full">
          <img 
            src={IMAGES.hero} 
            alt="Family dining at 1 Bite Restaurant" 
            className="w-full h-full object-cover"
          />
          <div className="absolute inset-0 bg-gradient-to-r from-black/80 via-black/50 to-transparent"></div>
        </div>

        <div className="relative z-10 text-left max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full mt-20">
          <div className="max-w-2xl">
            <span className="inline-block py-1 px-3 rounded-full bg-red-600/20 text-red-400 border border-red-500/30 text-sm font-medium tracking-wide mb-6 backdrop-blur-sm">
              Welcome to Kalikapur's Favorite
            </span>
            <h1 className="text-5xl md:text-7xl font-serif font-bold text-white leading-tight mb-6 drop-shadow-lg">
              Come and take a one bite closer to <span className="text-red-500 italic">food heaven.</span>
            </h1>
            <p className="text-xl md:text-2xl text-gray-200 mb-10 font-light drop-shadow-md">
              Kalikapur-er nijer thikana. <br/> Where every meal feels like a warm hug from home.
            </p>
            <div className="flex flex-col sm:flex-row space-y-4 sm:space-y-0 sm:space-x-4">
              <button 
                onClick={() => scrollToSection('menu')}
                className="bg-red-600 text-white px-8 py-4 rounded-full font-semibold text-lg hover:bg-red-700 transition-all flex items-center justify-center group shadow-xl shadow-red-600/30"
              >
                View Our Menu
                <ArrowRight className="ml-2 group-hover:translate-x-1 transition-transform" size={20} />
              </button>
              <button 
                onClick={() => scrollToSection('contact')}
                className="bg-white/10 backdrop-blur-md text-white border border-white/30 px-8 py-4 rounded-full font-semibold text-lg hover:bg-white/20 transition-all flex items-center justify-center"
              >
                Book a Table
              </button>
            </div>
          </div>
        </div>
      </section>

      {/* --- Highlights Grid --- */}
      <section className="py-12 bg-white relative -mt-10 z-20 max-w-6xl mx-auto rounded-2xl shadow-xl border border-gray-100 mx-4 sm:mx-auto">
        <div className="grid grid-cols-2 md:grid-cols-4 gap-6 px-6">
          {[
            { icon: <Heart className="text-red-500 mb-3" size={32}/>, title: "Family Vibe", desc: "A cozy place for everyone." },
            { icon: <ShieldCheck className="text-red-500 mb-3" size={32}/>, title: "100% Hygienic", desc: "Clean kitchen, fresh food." },
            { icon: <Utensils className="text-red-500 mb-3" size={32}/>, title: "Multicuisine", desc: "Bengali, Indian & Global." },
            { icon: <Coffee className="text-red-500 mb-3" size={32}/>, title: "Affordable", desc: "Premium taste, fair price." },
          ].map((feature, idx) => (
            <div key={idx} className="text-center flex flex-col items-center p-4 hover:-translate-y-1 transition-transform">
              {feature.icon}
              <h3 className="font-serif font-bold text-lg text-gray-900">{feature.title}</h3>
              <p className="text-sm text-gray-500 mt-1">{feature.desc}</p>
            </div>
          ))}
        </div>
      </section>

      {/* --- About Section --- */}
      <section id="about" className="py-24 bg-slate-50">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div className="flex flex-col md:flex-row items-center gap-16">
            <div className="md:w-1/2 relative">
              <div className="absolute inset-0 bg-red-100 translate-x-4 translate-y-4 rounded-2xl -z-10"></div>
              <img 
                src={IMAGES.about} 
                alt="1 Bite Restaurant Interior" 
                className="w-full rounded-2xl shadow-lg object-cover h-[500px]"
              />
              <div className="absolute -bottom-6 -left-6 bg-white p-6 rounded-2xl shadow-xl border border-gray-100">
                <div className="flex items-center space-x-4">
                  <div className="bg-red-100 p-3 rounded-full text-red-600">
                    <Star size={24} fill="currentColor" />
                  </div>
                  <div>
                    <p className="font-bold text-2xl text-gray-900">4.8/5</p>
                    <p className="text-sm text-gray-500 font-medium">Google Ratings</p>
                  </div>
                </div>
              </div>
            </div>
            <div className="md:w-1/2">
              <h4 className="text-red-600 font-bold tracking-wider uppercase text-sm mb-2">Our Story</h4>
              <h2 className="text-4xl md:text-5xl font-serif font-bold text-gray-900 mb-6">A dining room for the neighborhood.</h2>
              <div className="space-y-4 text-gray-600 leading-relaxed text-lg">
                <p>
                  We didn't just build a restaurant in Kalikapur; we built a second home for your family. At 1 Bite, we believe food is the truest language of love.
                </p>
                <p>
                  Whether it's the familiar comfort of Sunday <span className="italic font-medium text-gray-900">Kosha Mangsho</span> or the exciting zing of <span className="italic font-medium text-gray-900">Spicy Thai Tofu</span>, our kitchen insists on using fresh, locally sourced ingredients.
                </p>
                <p>
                  Experience a warm, hygienic, and affordable luxury dining space where every meal feels like a warm hug from home.
                </p>
              </div>
              <button onClick={() => scrollToSection('contact')} className="mt-8 text-red-600 font-semibold flex items-center hover:text-red-800 transition-colors">
                Visit Us Today <ChevronRight size={20} className="ml-1" />
              </button>
            </div>
          </div>
        </div>
      </section>

      {/* --- Menu Section --- */}
      <section id="menu" className="py-24 bg-white">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div className="text-center mb-16">
            <h4 className="text-red-600 font-bold tracking-wider uppercase text-sm mb-2">Our Menu</h4>
            <h2 className="text-4xl md:text-5xl font-serif font-bold text-gray-900 mb-6">Multicuisine Magic</h2>
            
            {/* Category Filter */}
            <div className="flex flex-wrap justify-center gap-3 mt-8">
              {MENU_CATEGORIES.map(category => (
                <button
                  key={category}
                  onClick={() => setActiveCategory(category)}
                  className={`px-6 py-2 rounded-full text-sm font-medium transition-all ${
                    activeCategory === category 
                      ? 'bg-red-600 text-white shadow-md' 
                      : 'bg-gray-100 text-gray-600 hover:bg-gray-200'
                  }`}
                >
                  {category}
                </button>
              ))}
            </div>
          </div>

          {/* Menu Grid */}
          <div className="grid md:grid-cols-2 gap-8">
            {filteredMenu.map(item => (
              <div 
                key={item.id} 
                className={`flex flex-col sm:flex-row bg-white rounded-2xl p-4 transition-all duration-300 hover:shadow-xl border ${item.highlight ? 'border-red-200 shadow-lg bg-red-50/30' : 'border-gray-100'}`}
              >
                {item.img ? (
                  <img src={item.img} alt={item.name} className="w-full sm:w-32 h-48 sm:h-32 object-cover rounded-xl mb-4 sm:mb-0 sm:mr-6" />
                ) : (
                  <div className="w-full sm:w-32 h-48 sm:h-32 bg-slate-100 rounded-xl mb-4 sm:mb-0 sm:mr-6 flex items-center justify-center">
                    <Utensils className="text-gray-300" size={32} />
                  </div>
                )}
                
                <div className="flex-1 flex flex-col justify-center">
                  <div className="flex justify-between items-start mb-2">
                    <div>
                      {item.highlight && <span className="text-xs font-bold text-red-600 uppercase tracking-wider mb-1 block">★ Signature Dish</span>}
                      <h3 className="font-serif font-bold text-xl text-gray-900">{item.name}</h3>
                    </div>
                    <span className="font-bold text-red-600 text-lg">{item.price}</span>
                  </div>
                  <p className="text-gray-500 text-sm leading-relaxed mb-3">{item.desc}</p>
                  <span className="text-xs text-gray-400 font-medium uppercase border border-gray-200 inline-block px-2 py-1 rounded w-max">
                    {item.category}
                  </span>
                </div>
              </div>
            ))}
          </div>

          <div className="mt-12 text-center">
            <button className="bg-gray-900 text-white px-8 py-3 rounded-full font-medium hover:bg-black transition-colors">
              Download Full Menu (PDF)
            </button>
          </div>
        </div>
      </section>

      {/* --- Banquet Section (Future Growth) --- */}
      <section id="banquet" className="py-24 bg-slate-900 text-white relative overflow-hidden">
        <div className="absolute inset-0 opacity-40">
           <img src={IMAGES.banquet} alt="Banquet Hall" className="w-full h-full object-cover" />
           <div className="absolute inset-0 bg-gradient-to-t from-slate-900 via-slate-900/80 to-slate-900/40"></div>
        </div>
        <div className="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center">
          <Star className="text-red-500 mx-auto mb-6" size={40} />
          <h2 className="text-4xl md:text-6xl font-serif font-bold mb-6">Host Your Memories With Us</h2>
          <p className="text-lg text-gray-300 mb-10 leading-relaxed">
            From intimate birthday parties to grand anniversary celebrations, our premium banquet space in Kalikapur is designed to make your special moments unforgettable. Experience top-tier catering and elegant decor.
          </p>
          <button onClick={() => scrollToSection('contact')} className="bg-red-600 text-white px-8 py-4 rounded-full font-semibold text-lg hover:bg-red-700 transition-all shadow-lg shadow-red-600/20">
            Inquire for Bookings
          </button>
        </div>
      </section>

      {/* --- Gallery Section --- */}
      <section id="gallery" className="py-24 bg-white">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
          <h4 className="text-red-600 font-bold tracking-wider uppercase text-sm mb-2">Atmosphere</h4>
          <h2 className="text-4xl font-serif font-bold text-gray-900 mb-12">Moments at 1 Bite</h2>
          
          <div className="grid grid-cols-2 md:grid-cols-4 gap-4">
            {IMAGES.gallery.map((img, i) => (
              <div key={i} className={`overflow-hidden rounded-2xl ${i === 0 || i === 3 ? 'md:col-span-2 md:row-span-2' : ''}`}>
                <img 
                  src={img} 
                  alt="Gallery image" 
                  className="w-full h-full object-cover min-h-[200px] hover:scale-110 transition-transform duration-700 cursor-pointer"
                />
              </div>
            ))}
          </div>
        </div>
      </section>

      {/* --- Reviews Section --- */}
      <section id="reviews" className="py-24 bg-red-50">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div className="text-center mb-16">
            <h2 className="text-4xl font-serif font-bold text-gray-900 mb-4">Loved by Kalikapur</h2>
            <div className="flex justify-center items-center space-x-2 text-red-500">
              <Star fill="currentColor" size={24}/>
              <Star fill="currentColor" size={24}/>
              <Star fill="currentColor" size={24}/>
              <Star fill="currentColor" size={24}/>
              <Star fill="currentColor" size={24}/>
            </div>
          </div>

          <div className="grid md:grid-cols-3 gap-8">
            {REVIEWS.map(review => (
              <div key={review.id} className="bg-white p-8 rounded-2xl shadow-sm border border-red-100 relative">
                <div className="text-red-200 mb-4">
                  <svg width="40" height="40" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                    <path d="M14.017 21L16.411 14.909C16.899 13.682 17.51 12.545 18.243 11.5H13.633V3H21.5V11.5C21.5 14.885 20.306 17.848 17.917 21H14.017ZM4.517 21L6.911 14.909C7.399 13.682 8.01 12.545 8.743 11.5H4.133V3H12V11.5C12 14.885 10.806 17.848 8.417 21H4.517Z" />
                  </svg>
                </div>
                <p className="text-gray-600 mb-6 italic leading-relaxed">"{review.text}"</p>
                <div className="flex items-center space-x-3">
                  <div className="w-10 h-10 bg-red-100 rounded-full flex items-center justify-center font-bold text-red-600">
                    {review.name.charAt(0)}
                  </div>
                  <div>
                    <h5 className="font-bold text-gray-900">{review.name}</h5>
                    <p className="text-xs text-gray-500">Local Guide</p>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      {/* --- Contact & Location Section --- */}
      <section id="contact" className="py-24 bg-white border-t border-gray-100">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div className="grid md:grid-cols-2 gap-16">
            
            {/* Contact Info */}
            <div>
              <h4 className="text-red-600 font-bold tracking-wider uppercase text-sm mb-2">Visit Us</h4>
              <h2 className="text-4xl font-serif font-bold text-gray-900 mb-8">We're waiting to serve you.</h2>
              
              <div className="space-y-6 mb-10">
                <div className="flex items-start">
                  <div className="bg-red-50 p-3 rounded-full mr-4 text-red-600 mt-1">
                    <MapPin size={24} />
                  </div>
                  <div>
                    <h5 className="font-bold text-gray-900 text-lg">Location</h5>
                    <p className="text-gray-600">123 Main Road, Near Kalikapur Crossing<br/>Kalikapur, Kolkata, West Bengal 700099</p>
                  </div>
                </div>
                
                <div className="flex items-start">
                  <div className="bg-red-50 p-3 rounded-full mr-4 text-red-600 mt-1">
                    <Phone size={24} />
                  </div>
                  <div>
                    <h5 className="font-bold text-gray-900 text-lg">Phone</h5>
                    <p className="text-gray-600">+91 98765 43210</p>
                    <p className="text-gray-600">+91 98765 01234 (Banquet Inquiries)</p>
                  </div>
                </div>

                <div className="flex items-start">
                  <div className="bg-red-50 p-3 rounded-full mr-4 text-red-600 mt-1">
                    <Clock size={24} />
                  </div>
                  <div>
                    <h5 className="font-bold text-gray-900 text-lg">Hours</h5>
                    <p className="text-gray-600">Monday - Sunday<br/>11:30 AM - 11:00 PM</p>
                  </div>
                </div>
              </div>

              {/* Action Buttons for Desktop */}
              <div className="hidden md:flex space-x-4">
                <button className="bg-red-600 text-white px-6 py-3 rounded-full font-medium hover:bg-red-700 transition-colors flex items-center">
                  <Phone size={18} className="mr-2" /> Call Now
                </button>
                <button className="bg-[#25D366] text-white px-6 py-3 rounded-full font-medium hover:bg-[#20bd5a] transition-colors flex items-center">
                  <MessageCircle size={18} className="mr-2" /> WhatsApp Order
                </button>
              </div>
            </div>

            {/* Form & Map */}
            <div className="bg-slate-50 p-8 rounded-3xl border border-gray-100 shadow-sm">
              <h3 className="font-serif font-bold text-2xl text-gray-900 mb-6">Send a Message</h3>
              <form className="space-y-4" onSubmit={(e) => e.preventDefault()}>
                <div>
                  <label className="block text-sm font-medium text-gray-700 mb-1">Name</label>
                  <input type="text" className="w-full px-4 py-3 rounded-xl border border-gray-200 focus:ring-2 focus:ring-red-500 focus:border-red-500 outline-none transition-all" placeholder="Your Name" />
                </div>
                <div>
                  <label className="block text-sm font-medium text-gray-700 mb-1">Phone</label>
                  <input type="tel" className="w-full px-4 py-3 rounded-xl border border-gray-200 focus:ring-2 focus:ring-red-500 focus:border-red-500 outline-none transition-all" placeholder="Your Phone Number" />
                </div>
                <div>
                  <label className="block text-sm font-medium text-gray-700 mb-1">Message (Optional)</label>
